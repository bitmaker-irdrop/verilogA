`include "constants.h"
`include "discipline.h"

module ldo_seq (dac, ss, act_en, trim);

    // ---------------- timing ----------------
    parameter real    Tstep       = 20u;   // sequencer tick (settle time per step)
    parameter real    start_delay = 100u;  // quiet time before the first tick
    parameter real    hold_top    = 200u;  // dwell at code_init before ramping down
    parameter integer dn_mult     = 1 from [1:inf);  // down-ramp tick = Tstep*dn_mult
    parameter real    tt          = 1u;    // bit transition time

    // ---------------- target / step size ----------------
    parameter integer code_init = 127 from [0:127];  // code to ramp UP to, and DC-bypass code
                                                     // 127 -> 3.675 V, 112 -> 3.3 V, 0 -> 500 mV
    parameter integer dac_step  = 1 from [1:127];    // codes advanced per tick on the dac ramp
    parameter integer ss_top    = 19 from [1:31];    // last soft-start code (next tick = MUX)
    parameter integer ss_step   = 1 from [1:31];     // codes advanced per tick on the ss ramp

    parameter integer mode    = 1 from [0:2];   // 0 up&hold, 1 up-down once, 2 cycle
    parameter integer en_tran = 1 from [0:1];   // 1 = run sequence, 0 = static hold (DC/STB)

    // ---------------- static codes ----------------
    parameter integer trim_code = 8 from [0:15];  // 4-bit system trim, never stepped
    parameter integer ss_def    = 0 from [0:31];  // ss held when en_tran = 0
    parameter integer act_def   = 1 from [0:1];   // act_en held when en_tran = 0

    // ---------------- levels ----------------
    parameter real vdd_hv = 2.5;   // dac bus
    parameter real vddc   = 1.5;   // ss, act_en, trim

    parameter integer verbose = 1 from [0:1];

    output [6:0] dac;      electrical [6:0] dac;      // output level code
    output [4:0] ss;       electrical [4:0] ss;       // soft-start mirror legs
    output       act_en;   electrical       act_en;   // 1 = buffer active, MUX -> main
    output [3:0] trim;     electrical [3:0] trim;     // system trim (static)

    integer dac_code, ss_code, act, trim_out;
    integer state, cnt, hold_cnt, div_now, sub, cyc;

    // modes
    localparam S_IDLE    = 0;   // waiting out start_delay
    localparam S_SS_UP   = 1;   // ss ramps up, output rides the clone
    localparam S_MUX_ON  = 2;   // act_en = 1, MUX -> main branch
    localparam S_DAC_UP  = 3;   // dac ramps up to code_init (first tick also clears ss)
    localparam S_HOLD    = 4;   // dwell at code_init
    localparam S_DAC_DN  = 5;   // dac ramps back down
    localparam S_PRECHG  = 6;   // dac = 0 and ss = ss_top together, clone charges
    localparam S_MUX_OFF = 7;   // act_en = 0, MUX -> clone
    localparam S_SS_DN   = 8;   // ss ramps down to 0
    localparam S_END     = 9;   // parked

    (* desc="ticks used going up"   *) integer n_up;
    (* desc="ticks used going down" *) integer n_dn;
    (* desc="completed cycles"      *) integer cycles;

    analog begin
        @(initial_step) begin
            dac_code = 0;
            ss_code  = 0;
            act      = 0;
            trim_out = trim_code;
            state    = S_IDLE;
            cnt      = 0;
            hold_cnt = 0;
            sub      = 0;
            div_now  = 1;
            cyc      = 0;
            cycles   = 0;
            // ceil(a/b) = (a + b - 1)/b  on positive integers
            n_up = (ss_top + ss_step - 1)/ss_step + 1
                 + (code_init + dac_step - 1)/dac_step;
            n_dn = (code_init + dac_step - 1)/dac_step + 2
                 + (ss_top + ss_step - 1)/ss_step - 1;
            if (!en_tran) begin
                dac_code = code_init;      // DC bypass: sit at the target code
                ss_code  = ss_def;
                act      = act_def;
            end
        end

        @(timer(start_delay, Tstep)) begin
            if (en_tran) begin
                // sub-tick divider: the down ramp may run slower than the up ramp
                sub = sub + 1;
                if (sub >= div_now) begin
                    sub = 0;

                    case (state)

                    S_IDLE: begin
                        // first tick steps the clone off zero
                        cnt = ss_step;
                        if (cnt > ss_top) cnt = ss_top;
                        ss_code = cnt;
                        div_now = 1;
                        state   = S_SS_UP;
                    end

                    S_SS_UP: begin
                        if (cnt < ss_top) begin
                            cnt = cnt + ss_step;
                            if (cnt > ss_top) cnt = ss_top;   // land exactly on ss_top
                            ss_code = cnt;
                        end else begin
                            act   = 1;          // MUX -> main, V_ref goes full
                            state = S_MUX_ON;
                        end
                    end

                    S_MUX_ON: begin
                        // clone no longer observed -> safe to kill the mirror legs
                        cnt = dac_step;
                        if (cnt > code_init) cnt = code_init;
                        dac_code = cnt;
                        ss_code  = 0;
                        state    = S_DAC_UP;
                    end

                    S_DAC_UP: begin
                        if (cnt < code_init) begin
                            cnt = cnt + dac_step;
                            if (cnt > code_init) cnt = code_init;  // land exactly on target
                            dac_code = cnt;
                        end else begin
                            hold_cnt = 0;
                            state    = S_HOLD;
                            if (verbose)
                                $strobe("LDO_SEQ up done: %d ticks, dac=%d", n_up, dac_code);
                        end
                    end

                    S_HOLD: begin
                        hold_cnt = hold_cnt + 1;
                        if (hold_cnt * Tstep >= hold_top) begin
                            if (mode == 0) begin
                                state = S_END;
                            end else begin
                                div_now = dn_mult;
                                cnt     = code_init;
                                state   = S_DAC_DN;
                            end
                        end
                    end

                    S_DAC_DN: begin
                        if (cnt > dac_step) begin
                            cnt      = cnt - dac_step;
                            dac_code = cnt;
                        end else begin
                            // charge the clone one tick BEFORE the MUX looks at it
                            dac_code = 0;
                            ss_code  = ss_top;
                            state    = S_PRECHG;
                        end
                    end

                    S_PRECHG: begin
                        act   = 0;              // MUX -> clone, already settled
                        state = S_MUX_OFF;
                    end

                    S_MUX_OFF: begin
                        cnt = ss_top - ss_step;
                        if (cnt < 0) cnt = 0;
                        ss_code = cnt;
                        state   = S_SS_DN;
                    end

                    S_SS_DN: begin
                        if (cnt > 0) begin
                            cnt = cnt - ss_step;
                            if (cnt < 0) cnt = 0;             // land exactly on zero
                            ss_code = cnt;
                        end else begin
                            cyc    = cyc + 1;
                            cycles = cyc;
                            if (verbose)
                                $strobe("LDO_SEQ down done: %d ticks, cycle %d", n_dn, cyc);
                            if (mode == 2) begin
                                div_now = 1;
                                state   = S_IDLE;
                            end else begin
                                state = S_END;
                            end
                        end
                    end

                    S_END: begin
                        // parked, outputs frozen
                    end

                    endcase
                end
            end
        end

        // ===================== outputs =====================
        V(dac[0]) <+ transition(((dac_code >> 0) & 1) * vdd_hv, 0, tt);
        V(dac[1]) <+ transition(((dac_code >> 1) & 1) * vdd_hv, 0, tt);
        V(dac[2]) <+ transition(((dac_code >> 2) & 1) * vdd_hv, 0, tt);
        V(dac[3]) <+ transition(((dac_code >> 3) & 1) * vdd_hv, 0, tt);
        V(dac[4]) <+ transition(((dac_code >> 4) & 1) * vdd_hv, 0, tt);
        V(dac[5]) <+ transition(((dac_code >> 5) & 1) * vdd_hv, 0, tt);
        V(dac[6]) <+ transition(((dac_code >> 6) & 1) * vdd_hv, 0, tt);

        V(ss[0]) <+ transition(((ss_code >> 0) & 1) * vddc, 0, tt);
        V(ss[1]) <+ transition(((ss_code >> 1) & 1) * vddc, 0, tt);
        V(ss[2]) <+ transition(((ss_code >> 2) & 1) * vddc, 0, tt);
        V(ss[3]) <+ transition(((ss_code >> 3) & 1) * vddc, 0, tt);
        V(ss[4]) <+ transition(((ss_code >> 4) & 1) * vddc, 0, tt);

        V(act_en) <+ transition(act * vddc, 0, tt);

        V(trim[0]) <+ transition(((trim_out >> 0) & 1) * vddc, 0, tt);
        V(trim[1]) <+ transition(((trim_out >> 1) & 1) * vddc, 0, tt);
        V(trim[2]) <+ transition(((trim_out >> 2) & 1) * vddc, 0, tt);
        V(trim[3]) <+ transition(((trim_out >> 3) & 1) * vddc, 0, tt);

        @(final_step)
            $strobe("LDO_SEQ done: state=%d dac=%d ss=%d act=%d trim=%d code_init=%d dac_step=%d ss_step=%d up=%d dn=%d cycles=%d",
                    state, dac_code, ss_code, act, trim_out, code_init, dac_step, ss_step, n_up, n_dn, cycles);
    end

endmodule
